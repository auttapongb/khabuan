# Copy to apps/api/.env or export before running

# demo | line
AUTH_MODE=demo

# memory | prisma
PERSISTENCE_MODE=memory

# Required when PERSISTENCE_MODE=prisma
DATABASE_URL=postgresql://mcg:mcg@localhost:5432/mcg_convoy?schema=public

# Optional — falls back to in-memory when unset / unreachable
REDIS_URL=redis://localhost:6379

# Session / JWT
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=7d
SESSION_COOKIE_NAME=mcg_session
COOKIE_SECURE=false

# LINE (required when AUTH_MODE=line)
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
# LINE Messaging API access token — powers the นำขบวน group bot (push/reply)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_LOGIN_CHANNEL_ID=
LIFF_ID=

# App
PORT=3001
HOST=0.0.0.0
WEB_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
PUBLIC_WEB_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3001

# Push-to-talk (LiveKit SFU). When false, PTT routes return 501.
PTT_ENABLED=false
# LIVEKIT_URL=wss://your-livekit-host

# ETA
ETA_PROVIDER=haversine
# OSRM_BASE_URL=https://router.project-osrm.org

# Arrival defaults
ARRIVAL_GEOFENCE_METERS=150
ARRIVAL_DWELL_SECONDS=60

# Badge rules
BADGE_RULE_VERSION=1.0.0
